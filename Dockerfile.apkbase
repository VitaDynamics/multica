# Local-only base images. The upstream backend Dockerfile apk-installs from
# dl-cdn.alpinelinux.org, which this host cannot reach (TLS connection reset).
# These are the exact upstream bases with the apk repository list repointed at
# a reachable mirror; docker-compose.selfhost.build.yml injects them as named
# build contexts so the upstream Dockerfile itself stays unpatched.
#
# Bump the FROM tags whenever upstream bumps them in Dockerfile — the context
# keys in the build override must match the upstream FROM lines exactly.
#
# Do NOT publish these images.

FROM golang:1.27.3-alpine AS golang
RUN sed -i 's|dl-cdn.alpinelinux.org|mirrors.aliyun.com|g' /etc/apk/repositories

FROM alpine:3.21 AS runtime
RUN sed -i 's|dl-cdn.alpinelinux.org|mirrors.aliyun.com|g' /etc/apk/repositories

FROM node:22.23.4-alpine AS node
RUN sed -i 's|dl-cdn.alpinelinux.org|mirrors.aliyun.com|g' /etc/apk/repositories
